{
  "expo": {
    "name": "Perch",
    "slug": "perch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/refined-logo.png",
    "scheme": "perch",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/refined-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.perch.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Perch uses your location to find nearby parking spots.",
        "NSLocationAlwaysUsageDescription": "Perch collects anonymized location data to build the heatmap."
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/refined-logo.png",
        "backgroundColor": "#2563EB"
      },
      "package": "com.perch.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCMsS4VyUOMVAFsJ4FmqOdfG8pDdHxnTls"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "AIzaSyCMsS4VyUOMVAFsJ4FmqOdfG8pDdHxnTls"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Perch uses your location to find nearby parking and build an anonymized heatmap."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Perch needs access to your photos to upload parking spot images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "259415a2-b792-4991-a937-c2711ebea1b3"
      },
      "router": {}
    },
    "owner": "jhejhe0707"
  }
}
